{
  "name": "sajad-haider-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "node server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --mode production --ssr src/entry-server.tsx --outDir dist/server",
    "generate-static": "node generate-static.js",
    "build:static": "npm run build && npm run generate-static",
    "preview": "cross-env NODE_ENV=production node server",
    "lint": "eslint .",
    "optimize-images": "node scripts/optimize-images.js",
    "organize-images": "node scripts/organize-images.js",
    "update-imports": "node scripts/update-imports.js",
    "rename-images": "node scripts/rename-images.js",
    "update-imports-after-rename": "node scripts/update-imports-after-rename.js"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@tabler/icons-react": "^3.33.0",
    "@tailwindcss/vite": "^4.1.3",
    "@tsparticles/engine": "^3.8.1",
    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "framer-motion": "^12.12.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.12.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.12.0",
    "react-router-dom": "^7.5.0",
    "simplex-noise": "^4.0.3",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.3",
    "tw-animate-css": "^1.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^13.0.0",
    "globals": "^16.0.0",
    "sharp": "^0.33.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
